diff --git a/.github/workflows/macos-arm64.yml b/.github/workflows/macos-arm64.yml
new file mode 100644
index 0000000..0d6b240
--- /dev/null
+++ b/.github/workflows/macos-arm64.yml
@@ -0,0 +1,36 @@
+name: macOS ARM64
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    runs-on: macos-15
+    timeout-minutes: 60
+    env:
+      MACOSX_DEPLOYMENT_TARGET: "13.0"
+      CARGO_TERM_COLOR: always
+    steps:
+      - uses: actions/checkout@v4
+      - name: Verify Apple Silicon runner
+        run: |
+          test "$(uname -s)" = Darwin
+          test "$(uname -m)" = arm64
+          sw_vers
+          rustc -vV
+      - name: Check game binaries
+        run: cargo check --locked -p skate-game --bins --no-default-features
+      - name: Run portable crate tests
+        run: cargo test --locked -p skate-core -p skate-audio -p skate-audio-fma -p skate-data -p skate-dynamics -p skate-mods -p skate-net
+      - name: Build native release
+        run: cargo build --release --locked -p skate-game --bin skate3rust --no-default-features
+      - name: Verify Mach-O architecture
+        run: |
+          file target/release/skate3rust
+          file target/release/skate3rust | grep -q 'arm64'
